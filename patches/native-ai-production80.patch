+    int ai_supply_demand(int owner,const a_vector<request>& req) {
+        int wanted=4;
+        for(auto r:req) {
+            const auto* type=get_unit_type(UnitTypes(r.type));
+            if(ut_building(type)||unit_race(type)!=st.players[owner].race
+                ||!game_st.unit_type_allowed[owner][type->id])continue;
+            bool home=!ut_worker(type)&&!(melee_ai&&st.players[owner].race!=race_t::terran&&r.priority>=80);
+            if(ai_count(owner,r.type,false,home)>=r.amount)continue;
+            bool producer=false;
+            for(auto* u:ptr(st.player_units[owner]))if(!unit_dying(u)&&unit_can_build(u,type)){producer=true;break;}
+            if(!producer)continue;
+            auto required=type->supply_required;
+            if(ut_two_units_in_one_egg(type))required*=2;
+            if(type->id==UnitTypes::Zerg_Lurker)required-=get_unit_type(UnitTypes::Zerg_Hydralisk)->supply_required;
+            wanted=std::max(wanted,int((required.raw_value+1)/2));
+        }
+        return wanted;
+    }
