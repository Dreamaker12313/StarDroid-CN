+    void ai_enter_bunkers(int owner,rect region,bool idle_only=false,int elevation_flags=0) {
+        if(owner<0||owner>=8)return;
+        a_unordered_map<unsigned,int> reserved;
+        // Orders already travelling to a bunker occupy a future seat. Repeated
+        // triggers/ticks must not redirect them or overbook the same four slots.
+        for(auto* u:ptr(st.player_units[owner])) {
+            auto* bunker=u->order_target.unit;
+            if(!unit_dying(u)&&!u_loaded(u)&&u->order_type->id==Orders::EnterTransport
+                &&bunker&&!unit_dying(bunker)&&unit_is(bunker,UnitTypes::Terran_Bunker)
+                &&unit_can_load_target(bunker,u))
+                reserved[get_unit_id(bunker).raw_value]+=u->unit_type->space_required;
+        }
+        for(auto* u:find_units(region)) {
+            if(u->owner!=owner||unit_dying(u)||!u_completed(u)||u_loaded(u)||us_hidden(u)
+                ||ut_building(u)||ut_worker(u)||ut_turret(u)||u_flying(u)||u_burrowed(u)
+                ||unit_is_disabled(u)||u_order_not_interruptible(u)||u_iscript_nobrk(u)
+                ||u->order_type->id==Orders::EnterTransport||ai_lifting(owner,u)
+                ||!unit_is_at_elevation_flags(u,elevation_flags))continue;
+            // Town maintenance only uses idle local defenders. A mission's
+            // explicit EnBk action may also order compatible non-firing troops.
+            if(idle_only&&(!ai_idle(u)||!unit_can_fire_from_bunker(u)
+                ||ai_attacking(towns[owner],u)||!u->order_queue.empty()||ut_hero(u)))continue;
+            // Preserve troops already requested for the next scripted wave.
+            // Garrisoned/bunker-bound units are not available attack reserves.
+            int type=int(u->unit_type->id);
+            if(idle_only&&type<228&&towns[owner].wave[type]>0
+                &&ai_count(owner,type,true,true)<=towns[owner].wave[type])continue;
+            unit_t* best=nullptr;int distance=0x7fffffff;
+            for(auto* bunker:ptr(st.player_units[owner])) {
+                if(!unit_is(bunker,UnitTypes::Terran_Bunker)||unit_dying(bunker)
+                    ||!unit_can_load_target(bunker,u)
+                    ||reserved[get_unit_id(bunker).raw_value]+int(u->unit_type->space_required)>int(unit_space_left(bunker)))continue;
+                int d=xy_length(bunker->position-u->position);
+                if(d<distance&&d<=320&&is_reachable(u,bunker->position)){best=bunker;distance=d;}
+            }
+            if(best) {
+                issue_order(u,false,get_order_type(Orders::EnterTransport),{best->position,best});
+                reserved[get_unit_id(best).raw_value]+=u->unit_type->space_required;
+                ++towns[owner].orders;
+            }
+        }
+    }
