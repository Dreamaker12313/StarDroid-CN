+    void apply_campaign_compatibility(int mission) {
+        if (mission != 502) return;
+        // Reign of Fire's original loss trigger tests Exactly 0 buildings and
+        // Exactly 0 Drones after their rescue. Exactly counts completed units,
+        // so spending both starting Drones on construction falsely ends play.
+        // Change only this recognized mission condition to At Most 0, which
+        // includes unfinished structures. Preserve ordinary CHK semantics and
+        // every other mission/custom-game condition, including real defeat.
+        game_load_functions rules(player.st());
+        for (auto& t : rules.game_st.triggers) {
+            auto& guard = t.conditions[0];
+            auto& buildings = t.conditions[1];
+            auto& drones = t.conditions[2];
+            if (guard.type != 11 || guard.extra_n != 20 || guard.num_n != 2 || (guard.flags & 2)
+                || buildings.type != 2 || buildings.group != 13 || buildings.unit_id != 231
+                || buildings.num_n != 10 || buildings.count_n != 0 || (buildings.flags & 2)
+                || drones.type != 2 || drones.group != 13 || drones.unit_id != int(UnitTypes::Zerg_Drone)
+                || drones.num_n != 10 || drones.count_n != 0 || (drones.flags & 2)
+                || t.conditions[3].type || t.actions[0].type != 2 || (t.actions[0].flags & 2)) continue;
+            buildings.num_n = 1;
+        }
+    }
