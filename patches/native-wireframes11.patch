+	// Use fixed-point health so small damage/healing is not rounded away. The
+	// region order is stable for this unit and never consumes simulation RNG.
+    int wire_damage_band(int64_t current,int64_t maximum,int bands) const {
+        if(maximum<=0)return 0;
+        int64_t missing=maximum-std::max<int64_t>(0,std::min(current,maximum));
+        return std::min(bands-1,int(missing*bands/maximum));
+    }
+    void wire_state(unit_t* u,int& steps,int& heat,int& shield) const {
+        int64_t maximum=u->unit_type->hitpoints.raw_value;
+        int64_t missing=maximum-std::max<int64_t>(0,std::min<int64_t>(u->hp.raw_value,maximum));
+        steps=maximum>0?int((missing*8+maximum-1)/maximum):0;
+        heat=wire_damage_band(u->hp.raw_value,maximum,6);
+        shield=u->unit_type->has_shield?
+            wire_damage_band(u->shield_points.raw_value,int64_t(u->unit_type->shield_points)*256,8):7;
+    }
 
