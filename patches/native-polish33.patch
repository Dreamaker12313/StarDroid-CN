+	// Describe the actual command/type data, including scenario-customized units.
+	a_string command_description(const cmd_t& c) const {
+		if (c.ut != UnitTypes::None && (c.act == C_BUILD || c.act == C_TRAIN || c.act == C_MORPH || c.act == C_MORPHBLDG || c.act == C_FIGHTER)) {
+			auto* t = get_unit_type(c.ut);
+			a_string text = ut_building(t) ? "Structure." : ut_flyer(t) ? "Air unit." : "Ground unit.";
+			if (ut_worker(t)) text += " Harvests minerals and Vespene Gas and builds structures.";
+			else if (t->ground_weapon && t->air_weapon) text += " Attacks ground and air targets.";
+			else if (t->ground_weapon) text += " Attacks ground targets.";
+			else if (t->air_weapon) text += " Attacks air targets.";
+			if (ut_detector(t)) text += " Detects cloaked and burrowed enemies.";
+			if (ut_resource_depot(t)) text += " Receives gathered resources.";
+			if (c.ut == UnitTypes::Zerg_Hatchery || c.ut == UnitTypes::Zerg_Lair || c.ut == UnitTypes::Zerg_Hive)
+				text += " Spawns larvae and spreads creep.";
+			if (t->supply_provided.raw_value > 0) text += format(" Provides %d supply.", t->supply_provided.raw_value / 2);
+			if (ut_two_units_in_one_egg(t)) text += " Morphs two units per egg; cost and supply are for the pair.";
+			return text;
+		}
+		switch (c.act) {
+		case C_MOVE: return "Moves to the chosen location.";
+		case C_STOP: return "Stops the current order.";
+		case C_ATTACK: return "Attacks a target, or moves to a location while engaging enemies.";
+		case C_GATHER: return "Gathers minerals or Vespene Gas from the chosen resource.";
+		case C_HOLD: return "Holds position and attacks enemies in range.";
+		case C_PATROL: return "Patrols between the current position and the chosen location.";
+		case C_BUILDMENU: return "Opens the basic structure menu.";
+		case C_ADVMENU: return "Opens the advanced structure menu.";
+		case C_STIM: return "Spends health to temporarily increase movement and attack speed.";
+		case C_SIEGE: return "Deploys the tank for long-range ground attacks. Cannot move while deployed.";
+		case C_UNSIEGE: return "Returns to mobile tank mode.";
+		case C_REPAIR: return "Repairs a damaged mechanical unit or structure using resources.";
+		case C_SELECT: return "Selects the associated units.";
+		case C_RALLY: return "Sets the destination for newly produced units.";
+		case C_LIFT: return "Lifts this structure into the air.";
+		case C_LAND: return "Lands this structure at the chosen location.";
+		case C_NYDUS: return "Creates a connected Nydus Canal exit on creep.";
+		case C_UNLOAD: return "Unloads this passenger.";
+		case C_UNLOADALL: return "Unloads all passengers.";
+		case C_RETURN: return "Returns carried resources to a nearby resource depot.";
+		case C_BURROW: return "Hides underground. Detectors can reveal burrowed units.";
+		case C_UNBURROW: return "Returns to the surface.";
+		case C_CLOAK: return "Cloaks the unit while draining energy. Detectors can reveal it.";
+		case C_DECLOAK: return "Ends cloaking and its energy drain.";
+		case C_ARCHON: return "Merges two High Templars into an Archon.";
+		case C_DARCHON: return "Merges two Dark Templars into a Dark Archon.";
+		case C_CANCEL: return "Cancels the current action or closes this command menu.";
+		default: return "";
 		}
 	}
 
