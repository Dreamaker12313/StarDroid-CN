+            if(ut_building(u)&&!unit_dying(u)&&units_distance(u,victim)<320){base=true;break;}
+        if(!base)return;
+        auto& alert=defence_alerts[owner];
+        if(alert.until<=ai_clock || !get_unit(alert.source)) {
+            alert.source=get_unit_id(source);alert.victim=get_unit_id(victim);
+            alert.wake=ai_clock+48; // Campaign response, not an instant global army pull.
+        }
+        alert.until=ai_clock+192;
+    }
+    void ai_defend(int owner) {
+        auto& alert=defence_alerts[owner];
+        if(alert.until<=ai_clock||alert.wake>ai_clock)return;
+        auto* source=get_unit(alert.source);auto* victim=get_unit(alert.victim);
+        if(!source||!victim||unit_dying(source)||unit_dying(victim)||victim->owner!=owner
+            || !unit_target_is_enemy(victim,source)||units_distance(victim,source)>640) {
+            alert={};return;
