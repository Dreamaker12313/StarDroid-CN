+	UnitTypes missing_upgrade_requirement(int owner, UpgradeTypes id) const {
+		using U = UnitTypes; using G = UpgradeTypes;
+		int level = player_upgrade_level(owner, id);
+		U req = U::None;
+		switch (id) {
+		case G::Terran_Infantry_Armor: case G::Terran_Vehicle_Plating: case G::Terran_Ship_Plating:
+		case G::Terran_Infantry_Weapons: case G::Terran_Vehicle_Weapons: case G::Terran_Ship_Weapons:
+			if (level > 0) req = U::Terran_Science_Facility;
+			break;
+		case G::Zerg_Carapace: case G::Zerg_Flyer_Carapace: case G::Zerg_Melee_Attacks:
+		case G::Zerg_Missile_Attacks: case G::Zerg_Flyer_Attacks:
+			if (level == 1) {
+				// A Hive morph retains the Lair prerequisite, as in the simulation.
+				if (player_has_completed_unit(owner, U::Zerg_Lair) || player_has_unit(owner, U::Zerg_Hive)) return U::None;
+				req = U::Zerg_Lair;
+			} else if (level == 2) req = U::Zerg_Hive;
+			break;
+		case G::Protoss_Ground_Armor: case G::Protoss_Ground_Weapons:
+			if (level > 0) req = U::Protoss_Templar_Archives;
+			break;
+		case G::Protoss_Air_Armor: case G::Protoss_Air_Weapons:
+			if (level > 0) req = U::Protoss_Fleet_Beacon;
+			break;
+		case G::Protoss_Plasma_Shields:
+			if (level > 0) req = U::Protoss_Cybernetics_Core;
+			break;
+		case G::Adrenal_Glands: req = U::Zerg_Hive; break;
+		case G::Charon_Boosters: req = U::Terran_Armory; break;
+		default: break;
+		}
+		return req != U::None && !player_has_completed_unit(owner, req) ? req : U::None;
+	}
