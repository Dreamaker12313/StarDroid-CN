+                TechTypes::Stim_Packs,TechTypes::Cloaking_Field,TechTypes::Personnel_Cloaking,
+                TechTypes::Restoration,TechTypes::Optical_Flare})
+                if(!player_has_researched(owner,tech)&&unit_tech_available(u,get_tech_type(tech),true))
+                    ai_request(towns[owner].techs,int(tech),1,85);
+    }
